{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.cts"]
}
